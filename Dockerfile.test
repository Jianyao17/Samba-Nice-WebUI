# syntax=docker/dockerfile:1

# Image khusus test: menjalankan smbd sungguhan, smbclient, dan seluruh pytest
# dalam satu container. Tidak perlu docker-compose.
#   docker build -f Dockerfile.test -t samba-nice-test .
#   docker run --rm samba-nice-test
FROM python:3.12-slim-bookworm

# 1. Samba server (smbd), client (smbclient), dan testparm untuk integration test
RUN apt-get update && apt-get install -y --no-install-recommends \
    samba \
    samba-common-bin \
    smbclient \
    passwd \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Keep a copy of the image defaults so an empty /etc volume can be seeded
RUN cp -a /etc /opt/etc-default

# 2. Astral uv (versi sama dengan Dockerfile produksi)
COPY --from=ghcr.io/astral-sh/uv:0.5.26 /uv /uvx /bin/

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    UV_LINK_MODE=copy

# 3. Install dependensi (termasuk extra dev: pytest, pytest-asyncio, httpx)
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra dev --no-install-project

# 4. Salin kode dan test, lalu pasang proyek
COPY src/ ./src/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY packaging/ ./packaging/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra dev

RUN chmod +x /app/scripts/docker-entrypoint.sh

# 5. Jalankan seluruh test secara default. Set PYTEST_ONLY=0 untuk menjalankan
#    smbd lalu WebUI di container yang sama (dipakai docker-compose.test.yml).
ENV PYTEST_ONLY=1
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
CMD ["pytest", "-v"]
