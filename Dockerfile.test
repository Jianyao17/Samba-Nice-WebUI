# syntax=docker/dockerfile:1

# Image khusus test: menjalankan smbd sungguhan, smbclient, dan seluruh pytest
# dalam satu container. Tidak perlu docker-compose.
#   docker build -f Dockerfile.test -t samba-nice-test .
#   docker run --rm samba-nice-test
FROM python:3.12-slim-bookworm

# 1. Samba server (smbd), client (smbclient), dan testparm untuk integration test
RUN apt-get update && apt-get install -y --no-install-recommends \
    samba \
    samba-common-bin \
    smbclient \
    procps \
    && rm -rf /var/lib/apt/lists/*

# 2. Astral uv (versi sama dengan Dockerfile produksi)
COPY --from=ghcr.io/astral-sh/uv:0.5.26 /uv /uvx /bin/

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    UV_LINK_MODE=copy

# 3. Install dependensi (termasuk extra dev: pytest, pytest-asyncio, httpx)
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra dev --no-install-project

# 4. Salin kode dan test, lalu pasang proyek
COPY src/ ./src/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY packaging/ ./packaging/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra dev

# 5. Jalankan seluruh test. Test Samba dijalankan sebagai root karena smbd butuh
#    akses penuh untuk mapping guest; semua state Samba berada di /tmp.
CMD ["pytest", "-v"]
