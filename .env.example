# ============================================================
# Samba-Nice-WebUI — Environment Configuration Template
# Copy this file to .env and adjust values before starting.
# ============================================================

# --- WebUI Server ---
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_SECRET_KEY=change-this-secret-key-in-production
WEBUI_ADMIN_USER=admin
WEBUI_ADMIN_PASSWORD=adminpassword

# --- Samba Paths ---
# Path to the DEDICATED INCLUDE FILE managed exclusively by this WebUI.
# ⚠ The primary smb.conf is NEVER touched by this app.
#   You must add the following line to your primary smb.conf once:
#     include = /etc/samba/smb.webui.conf
SAMBA_INCLUDE_CONF_PATH=/etc/samba/smb.webui.conf

# Directory where configuration history entries are stored.
# Identical configuration content is recorded only once (SHA-256 dedupe).
SAMBA_BACKUP_DIR=/etc/samba/.backups

# Path to the smbd master PID file (for zero-downtime SIGHUP reload)
SAMBA_PID_FILE=/var/run/samba/smbd.pid

# --- Storage Boundaries ---
# Comma-separated list of absolute paths that the WebUI may browse/create dirs in.
# All paths outside these roots are rejected. Each root gets its own browser panel
# on the Storage page.
ALLOWED_STORAGE_ROOTS=/storage,/data/shares

# --- Backend Mode ---
# Use 'linux' in production containers, 'mock' for local dev without Samba/Docker
SAMBA_BACKEND=mock
