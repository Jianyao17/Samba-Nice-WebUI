# ============================================================
# Samba-Nice-WebUI — Environment Configuration Template
# Copy this file to .env and adjust values before starting.
# ============================================================
#
# This application runs on Linux. On Windows/macOS, use the Docker
# image, which ships the required 'testparm' binary and a real Samba host.
#
# NOTE FOR BARE-METAL INSTALLATIONS:
# The bare-metal installer owns and generates /etc/samba-nice-webui/webui.env
# (mode 0600) automatically. To adjust settings on bare metal, edit
# /etc/samba-nice-webui/webui.env and restart the service:
#   sudo systemctl restart samba-nice-webui
# ============================================================

# --- WebUI Server ---
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_SECRET_KEY=change-this-secret-key-in-production
WEBUI_ADMIN_USER=admin
WEBUI_ADMIN_PASSWORD=adminpassword

# --- Samba Paths ---
# Path to the DEDICATED INCLUDE FILE managed exclusively by this WebUI.
# ⚠ The primary smb.conf is NEVER touched by this app.
#   You must add the following line to your primary smb.conf once:
#     include = /etc/samba/smb.webui.conf
SAMBA_INCLUDE_CONF_PATH=/etc/samba/smb.webui.conf

# Directory where configuration history entries are stored.
# Identical configuration content is recorded only once (SHA-256 dedupe).
SAMBA_BACKUP_DIR=/etc/samba/.backups

# Path to the smbd master PID file (for zero-downtime SIGHUP reload)
# On Debian 12 / Ubuntu 22.04+ bare-metal, smbd PID is typically /run/samba/smbd.pid
SAMBA_PID_FILE=/run/samba/smbd.pid

# --- SMB Client Address Display ---
# Hostname/IP and port that clients use to reach this Samba server.
# Leave SAMBA_SMB_HOST empty to use the hostname the browser used for the WebUI.
# Set these explicitly when running behind a reverse proxy or with a custom
# port mapping (for example localhost + 1445 in docker-compose.test.yml).
SAMBA_SMB_HOST=

# --- Storage Boundaries ---
# Comma-separated list of absolute paths that the WebUI may browse/create dirs in.
# All paths outside these roots are rejected. Each root gets its own browser panel
# on the Storage page. On bare metal, the installer defaults to /mnt.
ALLOWED_STORAGE_ROOTS=/mnt
