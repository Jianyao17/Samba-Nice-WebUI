# WebUI Server Configuration
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_SECRET_KEY=change-this-secret-key-in-production
WEBUI_ADMIN_USER=admin
WEBUI_ADMIN_PASSWORD=adminpassword

# Samba Configuration Paths
# Primary host configuration file (referenced for validation, not modified directly)
SAMBA_CONF_PATH=/etc/samba/smb.conf
# Dedicated include file where all WebUI-managed shares are stored (e.g. smb.webui.conf or smb.casaos.conf)
SAMBA_INCLUDE_CONF_PATH=/etc/samba/smb.webui.conf
SAMBA_BACKUP_DIR=/etc/samba/.backups
SAMBA_PID_FILE=/var/run/samba/smbd.pid

# Allowed Storage Roots (comma-separated absolute paths)
ALLOWED_STORAGE_ROOTS=/storage,/data/shares

# Active Backend Mode (linux | mock)
# Use 'mock' for local development on Windows without Samba/Docker
SAMBA_BACKEND=mock
